  <folder name="Views" id="id-5c8dce18a39949e3b587febb7d800dc4" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" name="Camunda MCP Plugin — Layered Architecture" id="id-387efb08795f4eb29556d7cbdde69a0d" connectionRouterType="2">
      <child xsi:type="archimate:DiagramObject" id="id-595c65cbcad94fd4abc05f0dce421d97" targetConnections="id-c4a521ea51084995b0fea3a89b61b90c" fontColor="#000000" fillColor="#c9e7cb" archimateElement="id-7a25e771403f4c06a1c50aec55e1a84b">
