<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Camunda MCP Plugin" id="id-1ee4f212f8d841b0b563247dcd469fd2" version="5.0.0">
  <folder name="Strategy" id="id-c67ed201d1f94dd484668aee1c77d902" type="strategy"/>
  <folder name="Business" id="id-cc2218a3c33d4b7da9a718ec6dfdc705" type="business"/>
  <folder name="Application" id="id-5fc216aa3d6f4f5f91a917ea34132ec4" type="application">
    <folder name="External Actors" id="id-db211a3e8df444d793ab49b36a487242">
      <element xsi:type="archimate:ApplicationComponent" name="Claude Code / AI Assistant" id="id-7a25e771403f4c06a1c50aec55e1a84b">
        <documentation>MCP client that sends JSON-RPC 2.0 tool calls to the plugin. Examples: Claude Code, GitHub Copilot, Cursor.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Camunda Desktop Modeler" id="id-addb0989fb9b46469875164a6830666d">
        <documentation>Electron-based desktop application for modeling BPMN, DMN, and Camunda Forms. Hosts the plugin as an Electron renderer extension.</documentation>
      </element>
    </folder>
    <folder name="Plugin Components" id="id-90d092bed7874ffcb05f3c49deb1bebc">
      <element xsi:type="archimate:ApplicationComponent" name="MCP HTTP Server" id="id-62206b8f7de74e548bf0e82d45849b2b">
        <documentation>Express-based HTTP server on port 3100 (configurable via MCP_PORT). Receives JSON-RPC 2.0 tool calls via Streamable HTTP transport and dispatches them to tool handlers.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="MCP Endpoint" id="id-a5a282bf8854457fab7f15d1e7ea1575">
        <documentation>HTTP endpoint at localhost:3100/mcp. Accepts Streamable HTTP transport with JSON-RPC 2.0 messages. This is the access point for AI assistants.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Tool Registry" id="id-c2509ebcf1614ab9aea90a35401c6380">
        <documentation>Registry of 19 MCP tools with Zod schemas defining input validation. Each tool has a name, description, and typed input schema.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Tool Dispatcher" id="id-5bab562fccdb47c28266c61376efb999">
        <documentation>Routes incoming tool calls to either local Node.js handlers (for create_model, form tools) or the Renderer Bridge (for bpmn-js canvas operations).</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Renderer Bridge" id="id-c9a6bd470391417eb77d8223eb13f8e3">
        <documentation>Forwards tool calls from the Node.js main process to the Chromium renderer process via webContents.executeJavaScript(). Uses UUID-based correlation for request/response matching with a 10-second timeout.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="bpmn-js Plugin Module" id="id-f17e97a822d74b268bb6d52992242f9f">
        <documentation>DI-injected module running in the Chromium renderer process. Calls bpmn-js Modeler APIs (modeling, elementRegistry, canvas, moddle) to manipulate the BPMN diagram. Webpack-bundled from client/ source.</documentation>
      </element>
    </folder>
    <folder name="Plugin Services" id="id-d817cd9c04054a50ad2a7efc9d6323f1">
      <element xsi:type="archimate:ApplicationService" name="BPMN Modeling Service" id="id-295c8bd9b6cb4168bff14a9b02611d09">
        <documentation>Service for creating and connecting BPMN elements: start events, tasks, gateways, end events, subprocesses, and sequence flows.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Element Configuration Service" id="id-366d60e640804c2589b6be71b19d8500">
        <documentation>Service for configuring element properties, I/O mappings, and task headers on existing BPMN elements.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Form Management Service" id="id-63455fa119c4424b87beb9499c115770">
        <documentation>Service for creating Camunda Forms, adding form fields, and linking forms to user tasks.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Introspection Service" id="id-6425a1d14342452aaf57736dd7008f99">
        <documentation>Service for querying the current diagram state: listing elements, getting element details, deleting elements, exporting/importing BPMN XML.</documentation>
      </element>
    </folder>
    <folder name="Tool Groups" id="id-e5ce842312104a4da86607a1d169c86a">
      <element xsi:type="archimate:ApplicationFunction" name="BPMN Element Tools" id="id-0487346ed764462e83d78f184015f3a5">
        <documentation>create_model, add_start_event, add_task, add_end_event, add_gateway, add_event, add_subprocess, connect_elements</documentation>
      </element>
      <element xsi:type="archimate:ApplicationFunction" name="Element Config Tools" id="id-4ab78eced1354c638a2727e1105b7a40">
        <documentation>set_properties, set_io_mapping, set_task_headers</documentation>
      </element>
      <element xsi:type="archimate:ApplicationFunction" name="Form Tools" id="id-0d4f83efaa6a474b857c7fd7a1b98534">
        <documentation>create_form, add_form_field, link_form_to_task</documentation>
      </element>
      <element xsi:type="archimate:ApplicationFunction" name="Introspection Tools" id="id-c0d78509c3a74d0cba22021f20ce9b35">
        <documentation>list_elements, get_element, delete_element, get_diagram_xml, import_xml</documentation>
      </element>
    </folder>
    <element xsi:type="archimate:ApplicationComponent" name="AI Coding Assistant" id="id-c195d3401c3040339589e0504b2dba7d">
      <documentation>External MCP client — Claude Code, GitHub Copilot, Cursor, or any MCP-compatible AI assistant.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="MCP Plugin" id="id-fb7303103a7849aa87b5f5d6da6e6e0e">
      <documentation>The Camunda MCP Plugin — an Electron plugin that exposes 19 BPMN/Forms tools via MCP HTTP protocol.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="MCP HTTP Server" id="id-a9ee292f3a7c445ca18cb3de653b952d">
      <documentation>Express HTTP server on port 3100 handling JSON-RPC 2.0 MCP protocol requests.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Tool Handlers" id="id-fb4351e378c942e1bad94550cb4f098a">
      <documentation>19 tools — BPMN elements, Camunda Forms, configuration, and introspection. Registered in tools/registry.js, dispatched via tools/handlers.js.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="bpmn-js Renderer Module" id="id-b01d5ffcda6f4b1da178de644821a4b9">
      <documentation>Chromium-side webpack-bundled plugin. Receives IPC commands and calls bpmn-js Modeler API (modeling, elementRegistry, canvas).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="MCP Client" id="id-8128021f0b594ae2a369bfa50a26f1ee">
      <documentation>External MCP client — Claude Code, GitHub Copilot, or any MCP-compatible AI coding assistant.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="MCP Server (Express:3100)" id="id-f56e9145b27748238966c0f76fae645c">
      <documentation>Express HTTP server on port 3100 handling JSON-RPC 2.0 MCP protocol requests via Streamable HTTP transport.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Tool Registry (Zod)" id="id-fb4316bdb3014d7895b27a9a97399566">
      <documentation>Registry of MCP tools with Zod schemas for input validation. Routes tool calls to local handlers or the renderer bridge.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="bpmn-js Plugin Module" id="id-ace0ec818d43457e8742e91500ff9481">
      <documentation>DI-injected module in the Chromium renderer. Calls bpmn-js Modeler APIs (modeling, elementRegistry, canvas, moddle) to manipulate the BPMN diagram.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Camunda Desktop Modeler" id="id-14e9acd6e2e144debdc6ef16dcaba3e9">
      <documentation>Electron-based desktop application for modeling BPMN, DMN, and Camunda Forms. The host application for the MCP plugin.</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-5bf5306b20934b3b8e2065b0da699a1a" type="technology">
    <element xsi:type="archimate:Node" name="Node.js Main Process" id="id-b0518119225b49f2b6281fc241f64b27">
      <documentation>Electron main process running Node.js. Hosts the MCP HTTP server, tool registry, dispatcher, and renderer bridge.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Chromium Renderer Process" id="id-123ce5d05dab472bbd8cbfbc489b4ee6">
      <documentation>Electron renderer process running Chromium. Hosts bpmn-js with the plugin module. Cannot use Node.js modules directly; code is webpack-bundled.</documentation>
    </element>
    <element xsi:type="archimate:CommunicationNetwork" name="Electron IPC / executeJavaScript" id="id-3c8afdde3b2b4ad4a0e87f81127d00ee">
      <documentation>Bridge between Electron main and renderer processes. Uses webContents.executeJavaScript() to invoke functions in the renderer and return results to the main process.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Express HTTP Framework" id="id-bfdcccb1aa6940b3a0d1ee46df2d2d88">
      <documentation>Express.js web framework serving the MCP endpoint on localhost:3100. Handles HTTP request/response lifecycle for Streamable HTTP transport.</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" name="HTTP Transport" id="id-55381fbc7b0046b8813f93322b3a8447">
      <documentation>Streamable HTTP transport layer providing the localhost:3100/mcp endpoint for JSON-RPC 2.0 communication.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Node.js / Express" id="id-b13a9086f9844471bd2b9854d280a7fd">
      <documentation>Node.js runtime running the Express MCP HTTP server in the Electron main process.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Chromium / Electron" id="id-73962b47ef464a549b1f4bf26d9d2e3c">
      <documentation>Electron's Chromium renderer process hosting the bpmn-js modeler and plugin UI.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="npm / webpack" id="id-e222393638f6493ea89dd7a7779efbbe">
      <documentation>Build tooling — npm for dependency management, webpack for bundling the Chromium-side client module.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Node.js Main Process" id="id-9ed068f928df42d2a15906289c75c024">
      <documentation>Electron main process. Hosts the Express MCP HTTP server and tool registry on 127.0.0.1:3100.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Chromium Renderer" id="id-3f9330eeb9484b5ea8d53c457107e5ab">
      <documentation>Electron renderer process running Chromium. Hosts the webpack-bundled bpmn-js plugin module.</documentation>
    </element>
  </folder>
  <folder name="Motivation" id="id-f23935d4ba7248d09944923a1b81aefb" type="motivation"/>
  <folder name="Implementation &amp; Migration" id="id-db4aa7712af149c4890d63672cf853f1" type="implementation_migration"/>
  <folder name="Other" id="id-379925ad377f4d1383e4e9584c6ef841" type="other">
    <element xsi:type="archimate:DataObject" name="BPMN 2.0 XML" id="id-226d33c65a7e453f94cdb13cfc9095df">
      <documentation>BPMN 2.0 XML diagram files (.bpmn). The primary artifact created and manipulated by the plugin tools.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Camunda Form JSON" id="id-641d9af7f3004cc79a960f995bba7de0">
      <documentation>Camunda Form definition files (.form). JSON-based form schemas created by the form tools.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="JSON-RPC 2.0 Messages" id="id-e320f6d885d94014b8575886bcd3cf9f">
      <documentation>MCP protocol messages exchanged between AI assistants and the plugin. JSON-RPC 2.0 request/response format over Streamable HTTP.</documentation>
    </element>
  </folder>
