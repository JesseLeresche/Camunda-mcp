{
  "name": "camunda-modeler-mcp-plugin",
  "version": "2.0.0",
  "description": "Camunda Desktop Modeler MCP plugin — exposes an MCP HTTP server so AI coding assistants can create and manipulate BPMN models",
  "main": "index.js",
  "scripts": {
    "build": "tsc && webpack --mode production",
    "dev": "tsc --watch & webpack --mode development --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "layout:test": "npx tsx dev/layout-tests.ts",
    "layout:test:dry": "npx tsx dev/layout-tests.ts --dry-run",
    "prepare": "husky"
  },
  "keywords": [
    "camunda",
    "modeler",
    "mcp",
    "bpmn",
    "plugin"
  ],
  "author": "Jesse Leresche",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JesseLeresche/Camunda-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/JesseLeresche/Camunda-mcp/issues"
  },
  "homepage": "https://github.com/JesseLeresche/Camunda-mcp#readme",
  "files": [
    "index.js",
    "menu.js",
    "dist/",
    "client/dist/",
    "docs/",
    "assets/",
    "BPMN-BEST-PRACTICES.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.2",
    "bpmn-auto-layout": "1.3.0",
    "chokidar": "^4.0.3",
    "express": "^4.21.0",
    "pdfjs-dist": "^6.2.108",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^26.2.0",
    "@types/uuid": "^10.0.0",
    "camunda-modeler-plugin-helpers": "^6.0.0",
    "camunda-modeler-webpack-plugin": "^0.2.0",
    "husky": "^9.1.7",
    "ts-loader": "^9.6.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  }
}
